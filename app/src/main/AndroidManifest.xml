<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 長押しメニューの「アンインストール」で OS の確認画面を開くため。削除はユーザーが OS 画面で確定する -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- システムモニター（docs/monitor.md）。本人の端末で使う前提で、取れる情報を最大にする -->
    <!-- アプリごとの使用時間・通信量・容量。OS の設定画面か adb で許可する -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- 温度センサーの値（dumpsys thermalservice）。adb で付与する -->
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <!-- プロセスの持ち主をアプリ名に直すため、起動できないアプリも含めて見る -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- 起動可能なアプリとウィジェット提供元を列挙するためのパッケージ可視性 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:name=".BentoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bento.Home">

        <activity
            android:name=".home.HomeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_label"
            android:theme="@style/Theme.Bento.Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".monitor.MonitorActivity"
            android:exported="false"
            android:label="@string/monitor_label"
            android:theme="@style/Theme.Bento.Settings" />

        <service
            android:name=".badge.BadgeListenerService"
            android:exported="true"
            android:label="@string/badge_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
